#!/bin/bash
# Launch the real recon MCP server the way its console script would.
#
# The client resolves a server name to a single executable, because that is what
# the package installs. In a checkout there is no installed `shinobi-recon`, so
# this stands in for it: the same `main()` the entry point calls, with the
# source tree importable. It exists so the client's MCP layer can be checked
# against the real server rather than only against a fake that agrees with it.
set -euo pipefail
root="${SHINOBI_REPO_ROOT:?SHINOBI_REPO_ROOT must point at the checkout}"
export PYTHONPATH="$root/mcp-servers/shinobi-recon${PYTHONPATH:+:$PYTHONPATH}"
exec "${SHINOBI_TEST_PYTHON:-python3}" -c 'import shinobi_recon.server as s; s.main()'
