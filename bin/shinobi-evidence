#!/usr/bin/env bash
# shinobi:summary=Manage hashed engagement evidence
# shinobi:args=<list|add|verify|tag|export> [args]
# shinobi:examples=shinobi evidence verify | shinobi evidence tag report.txt finding
set -euo pipefail
bin_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
root="$bin_dir/../libexec/shinobi"
# Packaged, bin/ is /usr/bin and libexec/shinobi/ is /usr/lib/shinobi.
[[ -d "$root" ]] || root="$bin_dir/../lib/shinobi"
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m shinobi_control.evidencectl "$@"
