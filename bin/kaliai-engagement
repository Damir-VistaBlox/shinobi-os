#!/usr/bin/env bash
# kaliai:summary=Scaffold, list, or switch the active engagement
# kaliai:args=<new|list|use> [name]
# kaliai:examples=kaliai engagement new acme-pentest | kaliai engagement use acme-pentest
set -euo pipefail
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/_kaliai-common.sh"

ENGAGEMENTS_DIR="$(kaliai_engagements_dir)"
STATE_FILE="$(kaliai_state_file)"

usage() {
  cat <<'USAGE'
Usage: kaliai-engagement <new|list|use> [name]

  new <name>    Scaffold a new engagement (scope file + log dir), make it active
  list          List known engagements
  use <name>    Set the active engagement for `kaliai-agent`
USAGE
}

cmd_new() {
  local name="${1:?usage: kaliai-engagement new <name>}"
  local dir="$ENGAGEMENTS_DIR/$name"
  if [[ -e "$dir" ]]; then
    echo "kaliai-engagement: engagement '$name' already exists at $dir" >&2
    exit 1
  fi
  mkdir -p "$dir"
  cat >"$dir/scope.yaml" <<YAML
# Authorized scope for this engagement. Every kaliai-recon tool call is
# checked against this file before it runs — out-of-scope targets are
# refused, not warned about. Edit before running anything.
client: "CHANGE ME"
authorized_by: "CHANGE ME (name + date of written authorization)"
window:
  start: "CHANGE ME (YYYY-MM-DD)"
  end: "CHANGE ME (YYYY-MM-DD)"
targets:
  # - 10.10.10.0/24
  # - app.client-example.com
YAML
  : >"$dir/log.jsonl"
  mkdir -p "$(dirname "$STATE_FILE")"
  echo "$name" >"$STATE_FILE"
  echo "Created engagement '$name' at $dir"
  echo "Edit $dir/scope.yaml before running any tools."
}

cmd_list() {
  local active
  active="$(kaliai_current_engagement)"
  if [[ ! -d "$ENGAGEMENTS_DIR" ]] || [[ -z "$(ls -A "$ENGAGEMENTS_DIR" 2>/dev/null)" ]]; then
    echo "No engagements yet. Create one with: kaliai-engagement new <name>"
    return
  fi
  for dir in "$ENGAGEMENTS_DIR"/*/; do
    local name
    name="$(basename "$dir")"
    if [[ "$name" == "$active" ]]; then
      echo "* $name (active)"
    else
      echo "  $name"
    fi
  done
}

cmd_use() {
  local name="${1:?usage: kaliai-engagement use <name>}"
  if [[ ! -d "$ENGAGEMENTS_DIR/$name" ]]; then
    echo "kaliai-engagement: no such engagement '$name'" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$STATE_FILE")"
  echo "$name" >"$STATE_FILE"
  echo "Active engagement: $name"
}

sub="${1:-}"
shift || true
case "$sub" in
  new) cmd_new "$@" ;;
  list) cmd_list "$@" ;;
  use) cmd_use "$@" ;;
  -h | --help | help | "") usage ;;
  *)
    echo "kaliai-engagement: unknown subcommand '$sub'" >&2
    usage >&2
    exit 1
    ;;
esac
