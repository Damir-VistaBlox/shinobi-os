#!/usr/bin/env bash
# shinobi:summary=Publish or inspect local Shinobi events
# shinobi:args=<publish|recent> [event] [json-payload]
# shinobi:examples=shinobi event publish theme.changed '{"theme":"matrix"}'
set -euo pipefail
bin_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
root="$bin_dir/../libexec/shinobi"
# Packaged, bin/ is /usr/bin and libexec/shinobi/ is /usr/lib/shinobi.
[[ -d "$root" ]] || root="$bin_dir/../lib/shinobi"
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
action="${1:-recent}"
shift || true
# -P: without it `python3 -m` (and `python3 -`, and `-c`) puts the current directory
# first on sys.path, so an operator standing in a directory they did not write (a
# cloned repository, something extracted from a target) would import its json.py
# in this process. PYTHONPATH, set above, is still honoured. Needs Python 3.11+.
python3 -P - "$action" "$@" <<'PY'
import json, sys
from shinobi_control import events
action = sys.argv[1]
if action == "recent":
    print(json.dumps(events.recent(), indent=2, sort_keys=True))
elif action == "publish":
    if len(sys.argv) < 3:
        raise SystemExit("usage: shinobi event publish <event> [json-payload]")
    payload = json.loads(sys.argv[3]) if len(sys.argv) > 3 else {}
    print(json.dumps(events.publish(sys.argv[2], payload), indent=2, sort_keys=True))
elif action in {"help", "-h", "--help"}:
    print("Usage: shinobi event <publish|recent> [event] [json-payload]")
else:
    raise SystemExit(f"unknown event action: {action}")
PY
