#!/usr/bin/env bash
# shinobi:summary=List and manage LLM providers available to Shinobi
# shinobi:args=<list|inspect|check|readiness|key|forget> [id]
# shinobi:examples=shinobi provider list | shinobi provider readiness
set -euo pipefail
bin_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
root="$bin_dir/../libexec/shinobi"
# Packaged, bin/ is /usr/bin and libexec/shinobi/ is /usr/lib/shinobi.
[[ -d "$root" ]] || root="$bin_dir/../lib/shinobi"
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m shinobi_control.providerctl "$@"
