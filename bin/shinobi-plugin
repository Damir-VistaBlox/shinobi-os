#!/usr/bin/env bash
# shinobi:summary=Validate and manage explicitly trusted Shinobi plugins
# shinobi:args=<list|audit|validate|install> [directory]
# shinobi:examples=shinobi plugin audit | shinobi plugin validate ./plugin
set -euo pipefail
bin_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
root="$bin_dir/../libexec/shinobi"
# Packaged, bin/ is /usr/bin and libexec/shinobi/ is /usr/lib/shinobi.
[[ -d "$root" ]] || root="$bin_dir/../lib/shinobi"
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m shinobi_control.pluginctl "$@"
