#!/usr/bin/env bash
# shinobi:summary=Inspect the Shinobi plugin directory
# shinobi:args=<list|audit>
# shinobi:examples=shinobi plugin list
set -euo pipefail
root="${SHINOBI_PLUGIN_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/shinobi/plugins}"
case "${1:-list}" in
  list) find "$root" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort ;;
  audit) find "$root" -mindepth 2 -maxdepth 2 -type f -name manifest.toml -print 2>/dev/null | sort ;;
  -h|--help|help) echo 'Usage: shinobi plugin <list|audit>' ;;
  *) echo 'shinobi-plugin: installation is disabled until plugin trust policy is configured' >&2; exit 77 ;;
esac
