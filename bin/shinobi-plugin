#!/usr/bin/env bash
# shinobi:summary=Validate and manage explicitly trusted Shinobi plugins
# shinobi:args=<list|audit|validate|install> [directory]
# shinobi:examples=shinobi plugin audit | shinobi plugin validate ./plugin
set -euo pipefail
root="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../libexec/shinobi"
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m shinobi_control.pluginctl "$@"
