#!/usr/bin/env bash
# shinobi:summary=Get or set the default coding agent shinobi launches
# shinobi:args=[name]
# shinobi:examples=shinobi default agent | shinobi default agent claude
#
# Ported from Omarchy's omarchy-default-agent, scoped down: no per-agent
# auto-installer (Omarchy uses `mise`, which we don't assume is present) —
# this only checks whether the binary is already on PATH and tells you how
# to get it if not.
set -euo pipefail

agent_file="$HOME/.config/shinobi/default-agent"

usage() {
  cat <<'USAGE'
Usage: shinobi-default-agent [<name>]

With no argument, print the current default agent (empty if unset).
With an argument, set it. Known names: claude, codex, gemini, aider, opencode.
Any other name is accepted too — shinobi only needs it on PATH.
USAGE
}

install_hint() {
  case "$1" in
    claude) echo "Install: https://docs.claude.com/en/docs/claude-code" ;;
    codex) echo "Install: npm install -g @openai/codex" ;;
    gemini) echo "Install: npm install -g @google/gemini-cli" ;;
    aider) echo "Install: pipx install aider-chat" ;;
    opencode) echo "Install: https://opencode.ai" ;;
    *) echo "Make sure '$1' is on PATH." ;;
  esac
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
esac

if (($# == 0)); then
  if [[ -f $agent_file ]]; then
    read -r agent <"$agent_file"
    [[ -n ${agent:-} ]] && echo "$agent"
  fi
  exit 0
fi

agent="$1"

if ! command -v "$agent" >/dev/null 2>&1; then
  echo "shinobi-default-agent: '$agent' is not on PATH." >&2
  install_hint "$agent" >&2
  exit 1
fi

mkdir -p "$(dirname "$agent_file")"
printf '%s\n' "$agent" >"$agent_file"
echo "Default agent set to: $agent"
