#!/usr/bin/env bash
# shinobi:summary=Check that the local Shinobi OS runtime is ready
# shinobi:args=
# shinobi:examples=shinobi doctor

set -euo pipefail

source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/_shinobi-common.sh"

if [[ "${1:-}" == "--json" ]]; then
  status=0
  missing_json=()
  for required in python3 nmap shinobi-recon; do
    command -v "$required" >/dev/null 2>&1 || { missing_json+=("\"$required\""); status=1; }
  done
  active_json="$(shinobi_current_engagement)"
  profile_json="observer"
  [[ -f "$(shinobi_state_home)/profile" ]] && profile_json="$(cat "$(shinobi_state_home)/profile")"
  shell_state="inactive"
  agent_state="inactive"
  context_state="inactive"
  if [[ "${XDG_CURRENT_DESKTOP:-}" == *Hyprland* ]]; then
    systemctl --user is-active --quiet shinobi-shell.service && shell_state=active || status=1
    systemctl --user is-active --quiet shinobi-agentd.service && agent_state=active || status=1
    systemctl --user is-active --quiet shinobi-contextd.service && context_state=active || status=1
  else
    shell_state=not-applicable
    agent_state=not-applicable
    context_state=not-applicable
  fi
  missing_payload="$(IFS=,; echo "${missing_json[*]:-}")"
  printf '{"status":"%s","missing":[%s],"engagement":"%s","profile":"%s","shell":"%s","agent":"%s","context":"%s","live":%s}\n' \
    "$([[ $status -eq 0 ]] && echo pass || echo failed)" "$missing_payload" "$active_json" "$profile_json" "$shell_state" "$agent_state" "$context_state" \
    "$([[ -f /run/live/medium/live/filesystem.squashfs ]] && echo true || echo false)"
  exit "$status"
fi

missing=()
for required in python3 nmap shinobi-recon; do
  command -v "$required" >/dev/null 2>&1 || missing+=("$required")
done

if ((${#missing[@]})); then
  printf 'Shinobi OS is missing: %s\n' "${missing[*]}" >&2
  exit 1
fi

active="$(shinobi_current_engagement)"
if [[ -n "$active" ]]; then
  scope_file="$(shinobi_engagements_dir)/$active/scope.yaml"
  if [[ -f "$scope_file" ]]; then
    printf 'Shinobi OS ready — active engagement: %s\n' "$active"
    printf 'Scope: %s\n' "$scope_file"
  else
    printf 'Shinobi OS ready — active engagement %q has no scope.yaml\n' "$active" >&2
    exit 1
  fi
else
  printf 'Shinobi OS ready — no active engagement. Start with: shinobi engagement new <name>\n'
fi

# The console-only image intentionally has no Quickshell. Check it only from
# the graphical Hyprland session, where a missing panel otherwise looks like a
# silent desktop failure.
if [[ "${XDG_CURRENT_DESKTOP:-}" == *Hyprland* ]]; then
  if ! command -v quickshell >/dev/null 2>&1; then
    printf 'Desktop check failed — quickshell is not installed.\n' >&2
    exit 1
  fi
  if ! systemctl --user is-active --quiet shinobi-shell.service; then
    printf 'Desktop check failed — Quickshell is not active. Inspect: journalctl --user -u shinobi-shell.service\n' >&2
    exit 1
  fi
  printf 'Desktop: Quickshell service active.\n'
  if systemctl --user is-active --quiet shinobi-agentd.service; then
    printf 'Agent control plane: active (profile: %s).\n' "$(cat "$(shinobi_state_home)/profile" 2>/dev/null || echo observer)"
  else
    printf 'Agent control plane: inactive.\n' >&2
    exit 1
  fi
  if systemctl --user is-active --quiet shinobi-contextd.service; then
    printf 'Desktop context service: active.\n'
  else
    printf 'Desktop context service: inactive.\n' >&2
    exit 1
  fi
fi
