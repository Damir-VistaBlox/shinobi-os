#!/usr/bin/env bash
# shinobi:summary=Check that the local Shinobi OS runtime is ready
# shinobi:args=
# shinobi:examples=shinobi doctor

set -euo pipefail

source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/_shinobi-common.sh"

doctor_security() {
  local failures=0 socket="$(shinobi_runtime_home)/agent.sock" audit="${SHINOBI_AUDIT_FILE:-$(shinobi_state_home)/audit.jsonl}"
  [[ ! -e "$socket" || "$(stat -c '%a' "$socket" 2>/dev/null)" == 600 ]] || { echo 'security: agent socket must be mode 0600'; failures=$((failures + 1)); }
  [[ ! -e "$audit" || "$(stat -c '%a' "$audit" 2>/dev/null)" == 600 ]] || { echo 'security: audit journal must be mode 0600'; failures=$((failures + 1)); }
  profile="$(cat "$(shinobi_state_home)/profile" 2>/dev/null || echo observer)"
  case "$profile" in observer|analyst|operator|administrator|emergency) ;; *) echo "security: invalid trust profile: $profile"; failures=$((failures + 1)) ;; esac
  doctor_privilege_boundary
  (( failures == 0 ))
}

# Privilege escalation is a real boundary, so check real invariants.
#
# The old check here required a Polkit action policy to be present. That policy
# declared five org.shinobi.* actions granting auth_admin, and nothing ever
# invoked them: shinobi-package and shinobi-update call `pkexec apt-get`, which
# raises org.freedesktop.policykit.exec and is governed by the distribution's
# own rules. So the file authorised nothing while reading as a control, and
# failing when it was absent pushed people to keep a file that did nothing --
# exactly backwards.
doctor_privilege_boundary() {
  local failures=0 found dir
  # The default roots cover a dpkg install. SHINOBI_DOCTOR_EXTRA_PATHS adds
  # colon-separated directories for a non-standard prefix; it can only add
  # places to look, never skip one.
  local extra=()
  if [[ -n "${SHINOBI_DOCTOR_EXTRA_PATHS:-}" ]]; then
    read -r -a extra <<<"${SHINOBI_DOCTOR_EXTRA_PATHS//:/ }"
  fi
  for dir in /usr/bin /usr/lib/shinobi /usr/libexec/shinobi "${extra[@]}"; do
    [[ -d "$dir" ]] || continue
    found="$(find "$dir" -maxdepth 1 \( -perm -4000 -o -perm -2000 \) -name 'shinobi*' -print 2>/dev/null || true)"
    if [[ -n "$found" ]]; then
      echo "security: setuid/setgid shinobi binary: $found"
      failures=$((failures + 1))
    fi
  done
  local policy="/usr/share/polkit-1/actions/org.shinobi.policy"
  if [[ -e "$policy" ]]; then
    echo "security: dead Polkit action policy present at $policy (it authorises nothing)"
    failures=$((failures + 1))
  fi
  (( failures == 0 ))
}

if [[ "${1:-}" == security ]]; then
  doctor_security
  exit $?
fi
if [[ "${1:-}" == services ]]; then
  exec shinobi-system status
fi

if [[ "${1:-}" == "--json" ]]; then
  category="${2:-all}"
  status=0
  missing_json=()
  for required in python3 nmap shinobi-recon; do
    command -v "$required" >/dev/null 2>&1 || { missing_json+=("\"$required\""); status=1; }
  done
  active_json="$(shinobi_current_engagement)"
  profile_json="observer"
  [[ -f "$(shinobi_state_home)/profile" ]] && profile_json="$(cat "$(shinobi_state_home)/profile")"
  shell_state="inactive"
  agent_state="inactive"
  context_state="inactive"
  profile_valid=true
  case "$profile_json" in observer|analyst|operator|administrator|emergency) ;; *) profile_valid=false; status=1 ;; esac
  if [[ "${XDG_CURRENT_DESKTOP:-}" == *Hyprland* ]]; then
    systemctl --user is-active --quiet shinobi-shell.service && shell_state=active || status=1
    systemctl --user is-active --quiet shinobi-agentd.service && agent_state=active || status=1
    systemctl --user is-active --quiet shinobi-contextd.service && context_state=active || status=1
  else
    shell_state=not-applicable
    agent_state=not-applicable
    context_state=not-applicable
  fi
  missing_payload="$(IFS=,; echo "${missing_json[*]:-}")"
  printf '{"status":"%s","category":"%s","missing":[%s],"engagement":"%s","profile":"%s","profile_valid":%s,"shell":"%s","agent":"%s","context":"%s","audit":"%s","live":%s}\n' \
    "$([[ $status -eq 0 ]] && echo pass || echo failed)" "$category" "$missing_payload" "$active_json" "$profile_json" "$profile_valid" "$shell_state" "$agent_state" "$context_state" "$( [[ -f "${SHINOBI_AUDIT_FILE:-$(shinobi_state_home)/audit.jsonl}" ]] && echo present || echo absent )" \
    "$([[ -f /run/live/medium/live/filesystem.squashfs ]] && echo true || echo false)"
  exit "$status"
fi

missing=()
for required in python3 nmap shinobi-recon; do
  command -v "$required" >/dev/null 2>&1 || missing+=("$required")
done

if ((${#missing[@]})); then
  printf 'Shinobi OS is missing: %s\n' "${missing[*]}" >&2
  exit 1
fi

active="$(shinobi_current_engagement)"
if [[ -n "$active" ]]; then
  scope_file="$(shinobi_engagements_dir)/$active/scope.yaml"
  if [[ -f "$scope_file" ]]; then
    printf 'Shinobi OS ready — active engagement: %s\n' "$active"
    printf 'Scope: %s\n' "$scope_file"
  else
    printf 'Shinobi OS ready — active engagement %q has no scope.yaml\n' "$active" >&2
    exit 1
  fi
else
  printf 'Shinobi OS ready — no active engagement. Start with: shinobi engagement new <name>\n'
fi

# Provider readiness.
#
# "AI offline" in the status bar has three quite different causes -- no key
# stored, no engagement clearing cloud egress, a trust profile below operator --
# and the bar cannot tell them apart. This reports them per provider, because
# they are separate fixes and "unavailable" is not something an operator can act
# on. Advisory: it exits non-zero when nothing is ready, and that must not turn
# a healthy desktop into a failing doctor, so the code is captured rather than
# propagated.
#
# The engagement and service checks above are the ones that decide the exit
# status. A machine with no LLM provider configured is a working Shinobi.
provider_readiness=""
if provider_ctl="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../libexec/shinobi/shinobi_control/providerctl.py"; then
  provider_readiness="$(PYTHONPATH="$(dirname -- "$(dirname -- "$provider_ctl")")" python3 -m shinobi_control.providerctl readiness 2>&1 || true)"
fi
if [[ -n "$provider_readiness" ]]; then
  printf '\n%s\n' "$provider_readiness"
fi

# The console-only image intentionally has no Quickshell. Check it only from
# the graphical Hyprland session, where a missing panel otherwise looks like a
# silent desktop failure.
if [[ "${XDG_CURRENT_DESKTOP:-}" == *Hyprland* ]]; then
  if ! command -v quickshell >/dev/null 2>&1; then
    printf 'Desktop check failed — quickshell is not installed.\n' >&2
    exit 1
  fi
  if ! systemctl --user is-active --quiet shinobi-shell.service; then
    printf 'Desktop check failed — Quickshell is not active. Inspect: journalctl --user -u shinobi-shell.service\n' >&2
    exit 1
  fi
  printf 'Desktop: Quickshell service active.\n'
  if systemctl --user is-active --quiet shinobi-agentd.service; then
    printf 'Agent control plane: active (profile: %s).\n' "$(cat "$(shinobi_state_home)/profile" 2>/dev/null || echo observer)"
  else
    printf 'Agent control plane: inactive.\n' >&2
    exit 1
  fi
  if systemctl --user is-active --quiet shinobi-contextd.service; then
    printf 'Desktop context service: active.\n'
  else
    printf 'Desktop context service: inactive.\n' >&2
    exit 1
  fi
fi
