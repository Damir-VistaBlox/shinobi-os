#!/usr/bin/env bash
# kaliai:summary=Toggle Hyprland gaps or window opacity
# kaliai:args=<gaps|opacity>
# kaliai:examples=kaliai hypr toggle gaps | kaliai hypr toggle opacity
#
# The couple of Hyprland toggles that need remembered state (gaps, opacity)
# and so can't be a single built-in dispatcher. Ported from Omarchy's
# omarchy-hyprland-window-gaps-toggle / -transparency-toggle.
# Fullscreen/centering/pin don't need this — they're plain
# `bind = ..., fullscreen` / `centerwindow` / `pin` in hyprland.conf.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: kaliai-hypr-toggle <gaps|opacity>

  gaps      Toggle between normal gaps and a zero-gap "compact" layout
  opacity   Toggle the focused window between opaque and 0.85 opacity
USAGE
}

action="${1:-}"
case "$action" in
  gaps)
    current="$(hyprctl getoption general:gaps_in -j | jq '.int')"
    if [[ "$current" == "0" ]]; then
      hyprctl --batch "keyword general:gaps_in 4 ; keyword general:gaps_out 8"
    else
      hyprctl --batch "keyword general:gaps_in 0 ; keyword general:gaps_out 0"
    fi
    ;;
  opacity)
    current="$(hyprctl getoption decoration:active_opacity -j | jq '.float')"
    if [[ "${current%.*}" == "1" ]]; then
      hyprctl keyword decoration:active_opacity 0.85
    else
      hyprctl keyword decoration:active_opacity 1.0
    fi
    ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 1 ;;
esac
