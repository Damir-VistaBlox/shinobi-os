#!/usr/bin/env bash
# shinobi:summary=Read the Shinobi desktop context service
# shinobi:args=[category]
# shinobi:examples=shinobi context | shinobi context network
set -euo pipefail
bin_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
root="$bin_dir/../libexec/shinobi"
# Packaged, bin/ is /usr/bin and libexec/shinobi/ is /usr/lib/shinobi.
[[ -d "$root" ]] || root="$bin_dir/../lib/shinobi"
exec python3 "$root/shinobi-contextctl" "${1:-}"
