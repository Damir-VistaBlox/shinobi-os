#!/usr/bin/env bash
# kaliai:summary=Print the scope file for the active (or named) engagement
# kaliai:args=show [name]
# kaliai:examples=kaliai scope show | kaliai scope show acme-pentest
set -euo pipefail
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/_kaliai-common.sh"

ENGAGEMENTS_DIR="$(kaliai_engagements_dir)"

usage() {
  echo "Usage: kaliai-scope show [name]"
}

cmd_show() {
  local name="${1:-$(kaliai_current_engagement)}"
  if [[ -z "$name" ]]; then
    echo "kaliai-scope: no active engagement. Run 'kaliai-engagement use <name>' first." >&2
    exit 1
  fi
  local scope_file="$ENGAGEMENTS_DIR/$name/scope.yaml"
  if [[ ! -f "$scope_file" ]]; then
    echo "kaliai-scope: no scope file for '$name' at $scope_file" >&2
    exit 1
  fi
  cat "$scope_file"
}

sub="${1:-}"
shift || true
case "$sub" in
  show) cmd_show "$@" ;;
  -h | --help | help | "") usage ;;
  *)
    echo "kaliai-scope: unknown subcommand '$sub'" >&2
    usage >&2
    exit 1
    ;;
esac
