#!/usr/bin/env bash
# shinobi:summary=List, validate, install, or run Shinobi hooks
# shinobi:args=<list|validate|install|run> [event] [path]
# shinobi:examples=shinobi hook list | shinobi hook run post-boot
set -euo pipefail

system_hooks="${SHINOBI_SYSTEM_HOOKS:-/etc/shinobi/hooks}"
user_hooks="${SHINOBI_USER_HOOKS:-${XDG_CONFIG_HOME:-$HOME/.config}/shinobi/hooks}"
action="${1:-list}"
event="${2:-}"

# A hooks root that anyone can write is a code-execution hole: `run` executes
# everything executable inside it, so a world-writable root means any local user
# can plant a hook that the next `shinobi hook run` will execute. Refuse rather
# than trust it, and say why.
require_secure_root() {
  local root="$1" label="$2" mode
  [[ -e "$root" ]] || return 0
  if [[ -L "$root" ]]; then
    echo "shinobi-hook: $label hooks root is a symlink: $root" >&2
    return 1
  fi
  mode="$(stat -c '%a' "$root" 2>/dev/null || echo '')"
  if [[ -z "$mode" ]]; then
    echo "shinobi-hook: cannot read the mode of $label hooks root: $root" >&2
    return 1
  fi
  if (( 0${mode} & 0022 )); then
    echo "shinobi-hook: $label hooks root is group/world-writable (mode $mode): $root" >&2
    echo "  anyone who can write there can add a hook that 'shinobi hook run' will execute" >&2
    return 1
  fi
}

# Event names become path components, so they are restricted to a single
# directory level. `install` did not check this at all, so
# `shinobi hook install ../../cron.d/x ./payload` wrote an executable outside the
# hooks tree.
valid_event() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]]
}

require_valid_event() {
  if ! valid_event "$1"; then
    echo "shinobi-hook: invalid hook event '$1' (expected [a-z0-9][a-z0-9-]*, max 64 chars)" >&2
    return 2
  fi
}

# Hooks actually executed are the executables directly inside <root>/<event>, so
# validation looks at exactly those. It used to walk the whole tree looking for
# *.sh, which both missed extensionless hooks and could be sent into a symlink
# loop or a deep tree.
collect_hooks() {
  local root="$1" event_name="$2"
  [[ -d "$root/$event_name" ]] || return 0
  find "$root/$event_name" -mindepth 1 -maxdepth 1 -type f -executable -print0 2>/dev/null | sort -z
}

# Running a user hook means running code the current user planted. On the live
# image and in scripts there is no terminal to ask, so that case is refused
# rather than silently allowed; system hooks under /etc are root-owned and are
# not gated this way.
confirm_user_hook() {
  local path="$1"
  if [[ "${SHINOBI_HOOK_ASSUME_YES:-0}" == "1" ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo "shinobi-hook: refusing to run user hook without confirmation: $path" >&2
    echo "  no terminal to ask on. Re-run with --yes or SHINOBI_HOOK_ASSUME_YES=1" >&2
    echo "  once you have read it, or remove it." >&2
    return 1
  fi
  printf 'shinobi-hook: about to run user hook %s\n  %s\n  Run it? [y/N] ' "$path" "$(head -c 200 "$path" 2>/dev/null | tr '\n' ' ')"
  local reply=""
  read -r reply || true
  case "$reply" in
    y|Y|yes|YES) return 0 ;;
    *) echo "shinobi-hook: skipped $path" >&2; return 1 ;;
  esac
}

case "$action" in
  list)
    for root in "$system_hooks" "$user_hooks"; do
      [[ -d "$root" ]] || continue
      find "$root" -mindepth 2 -maxdepth 2 -type f -executable -print 2>/dev/null | sort
    done
    ;;
  validate)
    checked=0
    for root in "$system_hooks" "$user_hooks"; do
      [[ -d "$root" ]] || continue
      require_secure_root "$root" "$([[ "$root" == "$user_hooks" ]] && echo user || echo system)" || exit 1
      for event_dir in "$root"/*/; do
        [[ -d "$event_dir" ]] || continue
        while IFS= read -r -d '' hook; do
          if ! head -c 2 "$hook" | grep -q '#!'; then
            echo "shinobi-hook: not a script (no shebang): $hook" >&2
            exit 1
          fi
          if ! bash -n "$hook" 2>/dev/null; then
            echo "invalid hook: $hook" >&2
            exit 1
          fi
          checked=$((checked + 1))
        done < <(collect_hooks "$root" "$(basename -- "$event_dir")")
      done
    done
    echo "hooks: valid ($checked hook(s))"
    ;;
  install)
    source_path="${3:?usage: shinobi hook install <event> <path>}"
    require_valid_event "$event"
    [[ -f "$source_path" && ! -L "$source_path" ]] || { echo "hook not found (or is a symlink): $source_path" >&2; exit 1; }
    head -c 2 "$source_path" | grep -q '#!' || { echo "not a script (no shebang): $source_path" >&2; exit 1; }
    bash -n "$source_path" || { echo "invalid hook: $source_path" >&2; exit 1; }
    mkdir -p "$user_hooks/$event"
    require_secure_root "$user_hooks" user
    target="$user_hooks/$event/$(basename -- "$source_path")"
    install -m 0755 "$source_path" "$target"
    echo "Installed hook: $target"
    echo "This is executable code that 'shinobi hook run $event' will run."
    ;;
  run)
    assume_yes=0
    for arg in "$@"; do [[ "$arg" == "--yes" || "$arg" == "-y" ]] && assume_yes=1; done
    require_valid_event "$event"
    # Not `local`: this branch is at script top level, not inside a function.
    refused=0
    ran=0
    for root in "$system_hooks" "$user_hooks"; do
      [[ -d "$root/$event" ]] || continue
      require_secure_root "$root" "$([[ "$root" == "$user_hooks" ]] && echo user || echo system)" || exit 1
      while IFS= read -r -d '' hook; do
        if [[ "$root" == "$user_hooks" && "$assume_yes" != "1" ]]; then
          if ! confirm_user_hook "$hook"; then
            refused=$((refused + 1))
            continue
          fi
        fi
        timeout "${SHINOBI_HOOK_TIMEOUT:-30}s" "$hook" || {
          echo "hook failed: $hook" >&2
          exit 1
        }
        ran=$((ran + 1))
      done < <(collect_hooks "$root" "$event")
    done
    # A refused hook is not an error, but it is not success either: the caller
    # asked for these hooks to run and one did not. Exiting 0 would let
    # `shinobi hook run` be chained in a script with no sign that anything was
    # skipped.
    if (( refused > 0 )); then
      echo "shinobi-hook: ran $ran hook(s), skipped $refused without confirmation" >&2
      exit 1
    fi
    ;;
  -h|--help|help) echo 'Usage: shinobi hook <list|validate|install|run> [event] [--yes] [path]' ;;
  *) echo "shinobi-hook: unknown action '$action'" >&2; exit 2 ;;
esac
