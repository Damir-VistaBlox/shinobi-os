#!/usr/bin/env bash
# shinobi:summary=Volume/mic control with an OSD popup
# shinobi:args=<up|down|mute-toggle|mic-mute-toggle|status>
# shinobi:examples=shinobi audio up | shinobi audio mute-toggle
#
# Ported from Omarchy's omarchy-audio-* + omarchy-osd. Uses pactl
# (pipewire-pulse), not amixer.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: shinobi-audio <up|down|mute-toggle|mic-mute-toggle|status>
USAGE
}

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -h string:x-canonical-private-synchronous:shinobi-audio -t 1500 "shinobi" "$1"
}

current_volume() {
  pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+(?=%)' | head -1
}

sink_muted() {
  pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}'
}

notify_volume() {
  if [[ "$(sink_muted)" == "yes" ]]; then
    notify "Muted"
  else
    notify "Volume: $(current_volume)%"
  fi
}

action="${1:-status}"
case "$action" in
  up) pactl set-sink-volume @DEFAULT_SINK@ +5%; notify_volume ;;
  down) pactl set-sink-volume @DEFAULT_SINK@ -5%; notify_volume ;;
  mute-toggle) pactl set-sink-mute @DEFAULT_SINK@ toggle; notify_volume ;;
  mic-mute-toggle)
    pactl set-source-mute @DEFAULT_SOURCE@ toggle
    muted="$(pactl get-source-mute @DEFAULT_SOURCE@ | awk '{print $2}')"
    [[ "$muted" == "yes" ]] && notify "Mic muted" || notify "Mic unmuted"
    ;;
  status) echo "$(current_volume)% $([[ $(sink_muted) == yes ]] && echo '(muted)')" ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 1 ;;
esac
