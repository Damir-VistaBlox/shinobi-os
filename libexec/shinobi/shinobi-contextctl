#!/usr/bin/env python3
"""CLI client for the read-only context service."""
from __future__ import annotations

import json
import os
import secrets
import socket
import sys
from pathlib import Path


def main() -> int:
    category = sys.argv[1] if len(sys.argv) > 1 else ""
    capability = "context.category" if category else "context.snapshot"
    arguments = {"category": category} if category else {}
    payload = {"protocol": 1, "request_id": secrets.token_hex(8), "capability": capability, "arguments": arguments}
    path = Path(os.environ.get("SHINOBI_CONTEXT_SOCKET", Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "shinobi/context.sock"))
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(10)
            client.connect(str(path))
            client.sendall((json.dumps(payload) + "\n").encode())
            data = client.recv(65536)
    except OSError as exc:
        print(f"shinobi context: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(json.loads(data), indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
