[Plymouth Theme]
Name=Shinobi
Description=Shinobi OS boot splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/shinobi
ScriptFile=/usr/share/plymouth/themes/shinobi/shinobi.script
ConsoleLogBackgroundColor=0x10141d
MonospaceFont=JetBrainsMono Nerd Font Mono 11
Font=JetBrainsMono Nerd Font Mono 11
