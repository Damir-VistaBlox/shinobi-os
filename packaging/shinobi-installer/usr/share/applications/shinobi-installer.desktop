[Desktop Entry]
Type=Application
Version=1.0
Name=Shinobi Installation Wizard
GenericName=Install Shinobi OS
Comment=Install Shinobi OS from this computer onto a disk
# Deliberately the same command, not a wrapper: an installed system can run the
# wizard too, which is how a machine is reinstalled or given a second disk
# without going back to the ISO. Calamares is in the same package as this
# launcher, so the entry point cannot outlive its dependencies.
Exec=calamares
Icon=shinobi-os
Terminal=false
Categories=System;
Keywords=install;installer;shinobi;setup;
StartupNotify=true
StartupWMClass=calamares