<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Shinobi OS</vendor>
  <vendor_url>https://github.com/Damir-VistaBlox/shinobi-os</vendor_url>
  <action id="org.shinobi.package.install">
    <description>Install a Shinobi-approved package</description>
    <message>Authentication is required to install a package</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="org.shinobi.package.remove">
    <description>Remove a Shinobi-approved package</description>
    <message>Authentication is required to remove a package</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="org.shinobi.update.apply">
    <description>Apply Shinobi OS updates</description>
    <message>Authentication is required to apply updates</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="org.shinobi.snapshot.restore">
    <description>Restore a Shinobi snapshot</description>
    <message>Authentication is required to restore a snapshot</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="org.shinobi.network.modify">
    <description>Modify network settings through Shinobi</description>
    <message>Authentication is required to modify network settings</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
</policyconfig>
