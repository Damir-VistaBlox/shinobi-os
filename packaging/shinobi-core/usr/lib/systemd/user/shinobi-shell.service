[Unit]
Description=Shinobi OS Quickshell
Requires=shinobi-migrate.service
After=shinobi-migrate.service graphical-session-pre.target
PartOf=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
Environment=QS_NO_RELOAD_POPUP=1
Environment=QS_DROP_EXPENSIVE_FONTS=1
Environment=XDG_CURRENT_DESKTOP=Hyprland
Environment=XDG_SESSION_DESKTOP=Hyprland
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/quickshell --path %h/.config/quickshell
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
