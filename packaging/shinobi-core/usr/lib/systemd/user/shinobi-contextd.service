[Unit]
Description=Shinobi desktop context service
PartOf=shinobi-desktop.target
After=shinobi-agentd.service

[Service]
Type=simple
ExecStart=/usr/lib/shinobi/shinobi-contextd
Restart=on-failure
RestartSec=2s
# See shinobi-agentd.service: ProtectSystem=strict bind-mounts every
# ReadWritePaths entry, and a missing one fails the unit at step NAMESPACING
# before ExecStart. RuntimeDirectory is created by systemd, so the path this
# unit needs to exist before the daemon that would create it does.
RuntimeDirectory=shinobi
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t/shinobi
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=shinobi-desktop.target
