#!/bin/sh
# Sets a background color on whatever SDDM theme actually got installed, via
# theme.conf.user — SDDM's documented mechanism for overriding a packaged
# theme's theme.conf without editing the package's own files. Deliberately
# defensive: this can't be visually tested from here (no display, no
# live-build execution environment on this dev machine), so it detects the
# installed theme and only writes an override if the theme already declares
# a `background` key, and never fails the build if anything is missing.
#
# Plymouth boot-splash theming is NOT done here — authoring a from-scratch
# Plymouth theme is script-based and only verifiable with an actual boot
# test, which isn't possible from this dev environment either. Confirm on a
# real build before investing in one; not worth shipping unverified.
set -e

# SDDM merges /usr/lib/sddm/sddm.conf.d/*.conf (package defaults), then
# /etc/sddm.conf.d/*.conf, then /etc/sddm.conf, each overriding the last —
# `sddm --example-config` prints SDDM's built-in template, not what's
# actually configured, so it's not used here. Best-effort: takes the last
# Current= line across all of them in that rough order.
sddm_theme_name="$(cat /usr/lib/sddm/sddm.conf.d/*.conf /etc/sddm.conf.d/*.conf /etc/sddm.conf 2>/dev/null | awk -F= '/^Current=/{v=$2} END{print v}')"

if [ -z "$sddm_theme_name" ]; then
  echo "kaliai: no SDDM Current= theme configured, skipping login theme override" >&2
  exit 0
fi

theme_dir="/usr/share/sddm/themes/$sddm_theme_name"
if [ ! -f "$theme_dir/theme.conf" ]; then
  echo "kaliai: SDDM theme '$sddm_theme_name' not found at $theme_dir, skipping" >&2
  exit 0
fi

if ! grep -q '^background=' "$theme_dir/theme.conf" 2>/dev/null; then
  echo "kaliai: SDDM theme '$sddm_theme_name' has no background= key, skipping override" >&2
  exit 0
fi

# Deliberately not writing a value here: `background=` is a file path in
# most SDDM QML themes (an Image source), not a color, and this hook has no
# way to confirm which this theme's QML expects without actually rendering
# it. Writing a guessed hex string risks a blank/broken login screen instead
# of a themed one. Logged so the theme + key are known for whoever verifies
# this on a real build and finishes the override by hand.
echo "kaliai: SDDM theme '$sddm_theme_name' at $theme_dir has a background= key — set it by hand in theme.conf.user once you know whether it wants a color or an image path"
