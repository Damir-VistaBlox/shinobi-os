#!/bin/sh
# Installs the shinobi CLI (all bin/shinobi* scripts), themes, and the
# shinobi-recon MCP server that distro/build.sh staged into /opt/shinobi (see
# that script — /opt/shinobi/{bin,mcp-servers,themes} are a generated copy of
# the repo's top-level bin/, mcp-servers/, themes/, not duplicated source).
set -e

# Install the integration layer as a real Debian package so systemd units,
# session helpers, and migration logic have explicit ownership and upgrades
# can replace them cleanly.
#
# apt, not dpkg -i, and that is load-bearing. The package depends on
# python3-mcp and python3-yaml; dpkg -i resolves nothing, so it would unpack the
# files, fail, and leave the package unconfigured with the server's dependency
# missing — and the postinst's import check, the thing that keeps a broken
# server from looking installed, would never get to run.
if [ -x /opt/shinobi/packaging/build-deb.sh ]; then
  /opt/shinobi/packaging/build-deb.sh /tmp/shinobi-core.deb >/dev/null
  apt-get install -y --no-install-recommends /tmp/shinobi-core.deb >/dev/null
  rm -f /tmp/shinobi-core.deb
fi

mkdir -p /usr/share/shinobi
if [ ! -d /usr/share/shinobi/themes ]; then
  cp -r /opt/shinobi/themes /usr/share/shinobi/themes
fi

# No venv, and no second copy of the server. It used to be pip-installed into
# /opt/shinobi/venv and symlinked into /usr/local/bin, which precedes /usr/bin in
# PATH — so the image ran a copy of the server that the package's postinst never
# verified, resolving its `mcp` by unpinned pip at build time. That is the exact
# failure the package now checks for, and it would have been reintroduced from
# the other side. The package ships one server, verified at install.

# Provenance: state the layering as a checkable fact rather than leaving it to be
# inferred from the version string.
#
# The point is not documentation. On an engagement host, "is this Kali, or
# something wearing Kali's name?" is the first question worth answering, and the
# answer has to be verifiable by whoever is holding the machine -- not asserted
# here. base_repo names the archive this image was built from, so a reviewer can
# diff the installed package set against upstream Kali and see that the tool
# suite is untouched, which is the whole security premise: the AI layer is the
# boundary, and it only works while the base is.
{
  printf 'layer=shinobi-os\n'
  printf 'layer_version=%s\n' "$(cat /usr/share/shinobi/version 2>/dev/null || printf 'unknown')"
  printf 'base=kali\n'
  printf 'base_id=%s\n' "$(. /etc/os-release 2>/dev/null; printf '%s' "${VERSION_ID:-unknown}")"
  printf 'base_repo=http.kali.org/kali kali-rolling main\n'
  printf 'relationship=overlay\n'
  printf 'relationship_note=Kali is the unmodified base: tool suite, kernel and archive.\n'
  printf 'The Shinobi layer sits on top and owns nothing Kali ships.\n'
} >/usr/share/shinobi/provenance
chmod 0644 /usr/share/shinobi/provenance
