#!/bin/sh
# Same pattern Kali's own variant-i3 uses (rsync from a static path staged by
# includes.chroot into /etc/skel and /root), just without a separate Debian
# package to hold the dotfiles.
set -e

rsync -a /usr/share/shinobi-dotfiles/etc/skel/ /etc/skel/
rsync -a /usr/share/shinobi-dotfiles/etc/skel/ /root/

# Kali's live image ships the `kali` account in the base filesystem, so the
# live-user setup script does not recreate it from /etc/skel. Provision its
# home explicitly or Hyprland falls back to its autogenerated config.
mkdir -p /home/kali
rsync -a /usr/share/shinobi-dotfiles/etc/skel/ /home/kali/
if getent passwd kali >/dev/null 2>&1; then
  chown -R kali:kali /home/kali/.config
fi
