#!/bin/sh
# Same pattern Kali's own variant-i3 uses (rsync from a static path staged by
# includes.chroot into /etc/skel and /root), just without a separate Debian
# package to hold the dotfiles.
set -e

rsync -a /usr/share/shinobi-dotfiles/etc/skel/ /etc/skel/
rsync -a /usr/share/shinobi-dotfiles/etc/skel/ /root/

# The account.
#
# Kali's live image ships `kali`, and that name was the last visible piece of
# Kali branding on a system that is otherwise Shinobi's -- every session began
# `kali@kali`. Renaming it is the last step of the rebrand, and it is safe
# because nothing in this image references the account by name: no SDDM
# autologin, no sudoers.d entry, no desktop file. The theme called `kali-dark`
# is ours and stays; it names a colour scheme, not the base distribution.
#
# usermod -l keeps the uid, the groups and the account's own identity, so
# anything already keyed to that uid keeps working. -m moves the home directory
# with it.
#
# Every step is guarded. This runs inside a chroot during the image build, and a
# hook that aborts on a `useradd` that failed for a reason nobody reproduced
# costs a whole build; a hook that logs and continues costs a system where the
# operator logs in as kali. The second is recoverable and the first is not.
if getent passwd kali >/dev/null 2>&1; then
  if ! getent passwd shinobi >/dev/null 2>&1; then
    usermod -l shinobi -d /home/shinobi -m kali \
      || echo "dotfiles: could not rename kali to shinobi; leaving the account as kali" >&2
  fi

  account=shinobi
  getent passwd "$account" >/dev/null 2>&1 || account=kali

  # A sudoers rule from the base image names the account. usermod does not
  # rewrite those, so a rename without this leaves a system where the operator
  # cannot install anything -- which looks like a broken image rather than a
  # missed step.
  if [ "$account" = shinobi ]; then
    for rule in /etc/sudoers.d/*; do
      [ -f "$rule" ] || continue
      grep -q '\bkali\b' "$rule" 2>/dev/null || continue
      sed -i 's/\bkali\b/shinobi/g' "$rule"
      echo "dotfiles: updated $rule to reference shinobi"
    done
  fi

  home="/home/$account"
  mkdir -p "$home"

  # -a preserves the source's ownership, and the staged tree is root-owned, so
  # this rsync lands root-owned files in the user's home. The previous version
  # chowned only .config, which left everything else root-owned -- and made the
  # whole home's ownership depend on which subdirectory happened to be listed.
  # A booted image reported "The home directory /home/kali does not belong to
  # the user you are currently creating", and mkdir -p against an existing
  # Kali-created /home/kali was a no-op that could never have fixed it.
  rsync -a --chown="$account:$account" /usr/share/shinobi-dotfiles/etc/skel/ "$home/"
  chown -R "$account:$account" "$home"

  # skel too, so a user created later by any tool that reads it inherits an
  # owned home rather than a root-owned one.
  if [ -d /etc/skel ]; then
    chown -R "$account:$account" /etc/skel 2>/dev/null || true
  fi
fi
