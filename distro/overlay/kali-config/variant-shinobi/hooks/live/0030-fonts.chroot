#!/bin/sh
# Installs a Nerd Font (patched glyphs Quickshell/wofi icons need — Debian's
# fonts-jetbrains-mono package is the *unpatched* upstream font, no icon
# glyphs). Fetched directly from upstream since Kali/Debian doesn't package
# a pre-patched Nerd Font under a reliable name.
#
# The version pin alone is not enough: a tag names a release, not the bytes, and
# this archive is unzipped into a system font directory that every boot then
# trusts. So the download is verified against a pinned SHA-256 before anything is
# unpacked, and the checksum is taken from the SHA-256.txt the release publishes
# alongside the asset.
#
# Bumping the version means bumping the checksum. To get the new one:
#   curl -fsSL https://github.com/ryanoasis/nerd-fonts/releases/download/<tag>/SHA-256.txt \
#     | grep -i "JetBrainsMono.zip"
set -e

NERD_FONT_VERSION="v3.5.1"
NERD_FONT_NAME="JetBrainsMono"
# JetBrainsMono.zip from nerd-fonts v3.5.1.
NERD_FONT_SHA256="fab782a66f7d3019da64f6572db9fc5d3a4bcb19f9fa13e2d8a62e3693d6396e"
DEST="/usr/share/fonts/shinobi-nerd-font"
ARCHIVE="/tmp/nerd-font.zip"

# Trap before the download so an interrupted or rejected fetch cannot leave a
# partial archive sitting in /tmp for something else to pick up.
trap 'rm -f "$ARCHIVE"' EXIT INT TERM

mkdir -p "$DEST"
curl -fsSL -o "$ARCHIVE" \
  "https://github.com/ryanoasis/nerd-fonts/releases/download/${NERD_FONT_VERSION}/${NERD_FONT_NAME}.zip"

# Verify before unpacking. Unzipping first and checking afterwards would leave a
# window in which unverified bytes are already in the font directory.
actual="$(sha256sum "$ARCHIVE" | cut -d' ' -f1)"
if [ "$actual" != "$NERD_FONT_SHA256" ]; then
  echo "0030-fonts: ${NERD_FONT_NAME}.zip sha256 mismatch" >&2
  echo "  expected: $NERD_FONT_SHA256" >&2
  echo "  actual:   $actual" >&2
  exit 1
fi

unzip -o -q "$ARCHIVE" -d "$DEST" '*.ttf'
rm -f "$ARCHIVE"
fc-cache -f "$DEST"
