#!/bin/sh
# Same as variant-shinobi's hook of the same name, minus the Quickshell-specific
# line (no desktop on this variant, so there's nothing to chmod for it).
# Duplicated rather than shared via a cross-variant symlink — the file is
# small, and a symlink into another symlinked variant directory would be a
# confusing thing for someone maintaining this a year from now.
set -e

chmod +x /opt/shinobi/bin/shinobi*
for script in /opt/shinobi/bin/shinobi*; do
  ln -sf "$script" "/usr/local/bin/$(basename "$script")"
done

mkdir -p /usr/share/shinobi
cp -r /opt/shinobi/themes /usr/share/shinobi/themes

python3 -m venv /opt/shinobi/venv
/opt/shinobi/venv/bin/pip install --no-cache-dir --quiet /opt/shinobi/mcp-servers/shinobi-recon
ln -sf /opt/shinobi/venv/bin/shinobi-recon /usr/local/bin/shinobi-recon
