#!/bin/sh
# Install the Shinobi layer as a Debian package.
#
# The console variant carries shinobi-core only: no desktop stack, no dotfiles,
# no compositor. Provenance is still written, because the base's identity is the
# one fact that matters on an engagement host regardless of what is installed on
# it.
set -eu

if [ ! -x /opt/shinobi/packaging/build-deb.sh ]; then
  echo "0020-shinobi-tooling: /opt/shinobi/packaging/build-deb.sh is missing." >&2
  echo "  distro/build.sh stages the repo's packaging/ into /opt/shinobi; without it there is nothing to build." >&2
  exit 1
fi

# apt, not dpkg -i: the package depends on python3-mcp and python3-yaml, and
# dpkg -i resolves nothing, so the postinst's import check would never run.
deb=/tmp/shinobi-core.deb
/opt/shinobi/packaging/build-deb.sh core "$deb" >/dev/null
apt-get install -y --no-install-recommends "$deb" >/dev/null
rm -f "$deb"

# No dotfiles are applied: there is no desktop and no desktop account to apply
# them to. The engine owns the provenance write so the ISO, install.sh and the
# wizard all produce byte-identical provenance, and so this hook is not a third
# copy of the format.
shinobi-setup provenance

# Assert rather than trust it. Provenance is the first artifact a reviewer of an
# engagement host reads, and a hook that continued past a missing write would
# ship a box with no answer to "is this Kali, or something wearing Kali's name?".
[ -s /usr/share/shinobi/provenance ] || {
  echo "0020-shinobi-tooling: provenance is missing; this image cannot state its base." >&2
  exit 1
}