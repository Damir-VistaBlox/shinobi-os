[Unit]
Description=Shinobi AI control-plane broker
PartOf=shinobi-desktop.target
After=shinobi-migrate.service

[Service]
Type=simple
ExecStart=/usr/lib/shinobi/shinobi-agentd
Restart=on-failure
RestartSec=2s
# systemd creates and removes this before ExecStart, which is what breaks the
# chicken-and-egg below: with ProtectSystem=strict, every ReadWritePaths entry
# is bind-mounted, and a bind mount of a path that does not exist fails the
# unit at step NAMESPACING -- before the daemon ever runs. It cannot create the
# directory itself, because it never starts. Both daemons crash-looped every
# two seconds on a live image until this was added.
RuntimeDirectory=shinobi
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/shinobi %t/shinobi
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=shinobi-desktop.target
