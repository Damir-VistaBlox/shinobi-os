{
  "layer": "top",
  "position": "top",
  "height": 32,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["custom/kaliai-engagement", "pulseaudio", "network", "bluetooth", "battery", "tray"],

  "hyprland/workspaces": {
    "format": "{id}"
  },

  "clock": {
    "format": "{:%Y-%m-%d %H:%M}"
  },

  "custom/kaliai-engagement": {
    "exec": "kaliai-waybar-engagement",
    "return-type": "json",
    "interval": 5,
    "tooltip": true
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": " {ifname}",
    "format-disconnected": "disconnected",
    "on-click": "kaliai-network menu",
    "on-click-right": "kaliai-network toggle"
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": " {device_alias}",
    "on-click": "kaliai-bluetooth menu",
    "on-click-right": "kaliai-bluetooth toggle"
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "muted",
    "format-icons": ["", "", ""],
    "on-click": "kaliai-audio mute-toggle",
    "on-scroll-up": "kaliai-audio up",
    "on-scroll-down": "kaliai-audio down"
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""]
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
