#!/bin/sh
# Waybar custom module: shows the active kaliai engagement (same state file
# `kaliai engagement use` writes) so it's always visible which scope.yaml is
# currently gating kaliai-recon's tool calls.
set -eu

state_file="$HOME/.local/state/kaliai/current-engagement"

if [ -f "$state_file" ]; then
  name="$(cat "$state_file")"
  printf '{"text": " %s", "tooltip": "Active KaliAI engagement: %s", "class": "active"}\n' "$name" "$name"
else
  printf '{"text": " none", "tooltip": "No active KaliAI engagement — run: kaliai engagement use <name>", "class": "none"}\n'
fi
